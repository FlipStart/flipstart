{
  "cli": {
    "version": ">= 18.13.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "environment": "development",
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://flipstart-production.up.railway.app"
      }
    },
    "preview": {
      "distribution": "internal"
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://flipstart-production.up.railway.app",
        "EXPO_PUBLIC_REVENUECAT_IOS_API_KEY": "appl_PASTE_YOUR_KEY_HERE"
      }
    }
  },
  "submit": {
    "production": {}
  }
}